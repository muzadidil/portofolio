rules_version = '2';

/*
 * Aturan keamanan Firestore — Portofolio Fuad.
 *
 * Inilah yang benar-benar menjaga data. Situsnya statis: seluruh kodenya,
 * termasuk projectId, terbaca siapa pun. Tanpa berkas ini, siapa pun yang
 * tahu projectId bisa mengubah atau menghapus portofolio lewat konsol
 * peramban, tanpa pernah melewati kolom password.
 *
 *   Pengunjung  boleh membaca daftar proyek
 *   Admin       boleh menambah, mengubah, dan menghapus
 *
 * Admin dikenali dari UID akunnya, bukan email: UID tidak bisa dipakai
 * orang lain walau akunnya suatu saat dihapus dan emailnya didaftarkan
 * ulang.
 *
 * Pasang: Firebase Console → Firestore Database → Rules → tempel → Publish.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Firebase Console → Authentication → Users → salin "User UID" akun admin.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'GANTI_DENGAN_UID_ADMIN';
    }

    // Bentuk yang sama dengan normalizeProject() di assets/js/portfolio.js.
    function isProject(d) {
      return d.keys().hasOnly(['name', 'categories', 'description', 'github', 'demo', 'year', 'status', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.categories is list && d.categories.size() <= 10
        && d.description is string && d.description.size() <= 2000
        && d.github is string && d.github.size() <= 500
        && d.demo is string && d.demo.size() <= 500
        && (d.year == null || d.year is int)
        && d.status in ['selesai', 'berjalan'];
    }

    match /projects/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && isProject(request.resource.data);
      allow delete: if isAdmin();
    }

    // Selain itu ditolak, supaya koleksi baru tidak diam-diam terbuka.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
