rules_version = '2';

/*
 * Aturan keamanan Firestore — Portofolio Fuad.
 *
 * PENTING, baca sekali supaya tahu persis keadaannya:
 *
 * Situs ini memakai password yang ditulis di dalam kode
 * (assets/js/config.js), bukan Firebase Authentication. Artinya tidak ada
 * akun yang bisa diperiksa di sini, dan aturan di bawah terpaksa
 * mengizinkan SIAPA PUN menulis ke koleksi projects — bukan hanya yang
 * tahu passwordnya. Kotak password di halaman hanya menutup tampilan
 * admin, bukan datanya.
 *
 * Yang masih dijaga berkas ini:
 *   - hanya koleksi `projects` yang bisa disentuh, tidak ada yang lain;
 *   - bentuk datanya harus benar, jadi isian ngawur tidak bisa masuk;
 *   - ukurannya dibatasi, jadi tidak bisa dipakai menumpang menyimpan
 *     berkas besar.
 *
 * Karena itu, simpan cadangan dari tombol "Cadangkan" di halaman admin
 * sesekali. Kalau isinya dihapus orang, itulah jalan pulihnya.
 *
 * Kalau suatu saat mau benar-benar dikunci: nyalakan Firebase
 * Authentication → Email/Password, buat satu akun admin, lalu ganti
 * `allow write` di bawah menjadi
 *
 *     allow create, update: if request.auth != null
 *       && request.auth.uid == 'UID_AKUN_ADMIN'
 *       && isProject(request.resource.data);
 *     allow delete: if request.auth != null
 *       && request.auth.uid == 'UID_AKUN_ADMIN';
 *
 * Langkahnya ada di README.
 *
 * Pasang: Firebase Console → Firestore Database → Rules → tempel → Publish.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Bentuk yang sama dengan normalizeProject() di assets/js/portfolio.js.
    function isProject(d) {
      return d.keys().hasOnly(['name', 'categories', 'description', 'github', 'demo', 'year', 'status', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.categories is list && d.categories.size() <= 10
        && d.description is string && d.description.size() <= 2000
        && d.github is string && d.github.size() <= 500
        && d.demo is string && d.demo.size() <= 500
        && (d.year == null || d.year is int)
        && d.status in ['selesai', 'berjalan'];
    }

    match /projects/{id} {
      allow read: if true;
      allow create, update: if isProject(request.resource.data);
      allow delete: if true;
    }

    // Selain itu ditolak, supaya koleksi baru tidak diam-diam terbuka.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
